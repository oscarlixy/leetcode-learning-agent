{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "language_standard",
    "objective",
    "session_minutes",
    "teaching_mode",
    "hint_policy",
    "problem_source_mode",
    "timezone"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "language": {
      "const": "cpp"
    },
    "language_standard": {
      "const": "c++20"
    },
    "objective": {
      "const": "foundations"
    },
    "session_minutes": {
      "const": 40
    },
    "teaching_mode": {
      "const": "socratic"
    },
    "hint_policy": {
      "const": "progressive-five-level"
    },
    "problem_source_mode": {
      "const": "hybrid"
    },
    "timezone": {
      "const": "Asia/Hong_Kong"
    }
  }
}
